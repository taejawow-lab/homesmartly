---
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import References from '../components/References.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
export interface Props { title:string; description:string; pubDate:Date; updatedDate?:Date; heroImage?:string; tags?:string[]; category?:string; sources?:Array<{title:string;url:string;author?:string;year?:string}>; affiliate?:boolean; visualsCount?:number; hasVideo?:boolean; headings?:Array<{depth:number;slug:string;text:string}>; faq?:Array<{question:string;answer:string}>; internalLinks?:string[]; }
const { title, description, pubDate, updatedDate, heroImage, tags=[], category, sources=[], affiliate=false, visualsCount=0, hasVideo=false, headings=[], faq=[], internalLinks=[] } = Astro.props;
const siteUrl = (Astro.site ? Astro.site.toString().replace(/\/$/, '') : (import.meta.env.PUBLIC_SITE_URL || 'https://homesmartly.org'));
const articleSchema = {'@context':'https://schema.org','@type':'Article',headline:title,description,image:heroImage,datePublished:pubDate?.toISOString(),dateModified:(updatedDate||pubDate)?.toISOString(),author:{'@type':'Organization',name:'homesmartly Editorial Team'},publisher:{'@type':'NewsMediaOrganization',name:'homesmartly',url:siteUrl}};
const categorySlug = category ? category.toLowerCase().trim().replace(/\s+/g, '-') : '';
---
<BaseLayout title={title} description={description} image={heroImage} type="article" publishedTime={pubDate?.toISOString()} modifiedTime={(updatedDate || pubDate)?.toISOString()} schema={articleSchema} active="posts">
  <article class="wrap article-shell">
    <header class="article-hero">
      {category && <a href={`/category/${categorySlug}/`} class="tag">{category}</a>}
      <h1 class="article-title">{title}</h1>
      <p class="article-dek">{description}</p>
      <div class="article-meta"><time datetime={pubDate?.toISOString()}>{pubDate?.toLocaleDateString('en-US')}</time><span>{sources.length} sources cited</span>{visualsCount > 0 && <span>{visualsCount} visuals</span>}{hasVideo && <span>Video summary</span>}</div>
    </header>
    {heroImage && <img src={heroImage} alt={title} width="1280" height="720" loading="eager" fetchpriority="high" decoding="async" class="article-image" />}
    {affiliate && <AffiliateDisclosure />}
    <div class="article-grid">
      <div class="prose-article"><slot />{sources.length > 0 && <References sources={sources} />}</div>
      {headings.length > 0 && <aside class="article-sidebar"><TOC headings={headings} /></aside>}
    </div>
    {internalLinks.length > 0 && <section class="related-box"><h2 class="h-md serif">Related reading</h2><ul>{internalLinks.map((link)=><li><a class="alink" href={link}>{link}<span class="arw">→</span></a></li>)}</ul></section>}
    {tags.length > 0 && <footer class="tag-list">{tags.map((tag)=><a class="tag" href={`/tags/${tag.toLowerCase().trim().replace(/[\/\\&%?#=]/g,'-').replace(/\s+/g,'-').replace(/-+/g,'-').replace(/^-|-$/g,'')}/`}>#{tag}</a>)}</footer>}
  </article>
</BaseLayout>

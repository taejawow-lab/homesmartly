---
export interface Props { title: string; description: string; href: string; image?: string; category?: string; pubDate: Date; variant?: 'feature' | 'standard'; index?: number; }
const { title, description, href, image, category, pubDate, variant = 'standard', index = 0 } = Astro.props;
const dateline = pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase();
const itemNum = String(index + 1).padStart(2, '0');
---
<a class="post-card reveal" href={href}>
  <div class="thumb">
    {image ? <img src={image} alt={title} loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover" /> : <svg viewBox="0 0 300 225" width="100%" height="100%"><g fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linejoin="round"><path d="M110 110 L150 80 L190 110"/><path d="M120 105 V150 h60 V105" opacity="0.5"/></g><circle cx="150" cy="70" r="4" fill="var(--accent)"/></svg>}
  </div>
  <div class="meta"><span class="idx">№ {itemNum}</span><span class="divider-dot">·</span><span>{category || dateline}</span></div>
  <h3 class="serif">{title}</h3>
  <p>{description}</p>
</a>

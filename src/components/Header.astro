---
const active = Astro.props.active || '';
const navItems = [
  { label: 'Posts', href: '/posts/', key: 'posts' },
  { label: 'Guides', href: '/guide/', key: 'guides' },
  { label: 'Tools', href: '/compatibility-checker/', key: 'tools' },
  { label: 'About', href: '/about/', key: 'about' },
];
---
<header class="site-head">
  <div class="wrap nav">
    <a class="brand" href="/" aria-label="homesmartly home"><svg class="logo" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M5 14.2 16 5l11 9.2" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.3 13.4V25a1.6 1.6 0 0 0 1.6 1.6h14.2A1.6 1.6 0 0 0 24.7 25V13.4" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" opacity="0.45"/><line x1="16" y1="6.5" x2="11.3" y2="19.6" stroke="currentColor" stroke-width="1.4" opacity="0.5"/><line x1="16" y1="6.5" x2="20.7" y2="19.6" stroke="currentColor" stroke-width="1.4" opacity="0.5"/><line x1="11.3" y1="19.6" x2="20.7" y2="19.6" stroke="currentColor" stroke-width="1.4" opacity="0.5"/><circle cx="16" cy="6.5" r="2.6" fill="var(--accent)"/><circle cx="11.3" cy="19.6" r="2.4" fill="currentColor"/><circle cx="20.7" cy="19.6" r="2.4" fill="currentColor"/></svg><span>home<b>smartly</b></span></a>
    <nav class="nav-links" aria-label="Primary navigation">
      {navItems.map((item) => <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <span class="nav-spacer"></span>
    <div class="nav-tools">
      <a class="icon-btn" href="/search/" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg></a>
      <button class="icon-btn" data-theme-toggle aria-label="Toggle theme"><span class="theme-toggle" style="display:grid;place-items:center;width:18px;height:18px"><svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><line x1="12" y1="2.5" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="21.5"/><line x1="2.5" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="21.5" y2="12"/><line x1="4.9" y1="4.9" x2="6.7" y2="6.7"/><line x1="17.3" y1="17.3" x2="19.1" y2="19.1"/><line x1="19.1" y1="4.9" x2="17.3" y2="6.7"/><line x1="6.7" y1="17.3" x2="4.9" y2="19.1"/></svg><svg class="moon" viewBox="0 0 24 24" fill="currentColor"><path d="M20 14.5A8 8 0 0 1 9.5 4 7 7 0 1 0 20 14.5Z"/></svg></span></button>
      <button class="icon-btn menu-btn" data-menu aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/></svg></button>
    </div>
  </div>
</header>
<div class="drawer" data-drawer>
  <div class="drawer-head"><a class="brand" href="/"><svg class="logo" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M5 14.2 16 5l11 9.2" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.3 13.4V25a1.6 1.6 0 0 0 1.6 1.6h14.2A1.6 1.6 0 0 0 24.7 25V13.4" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" opacity="0.45"/><line x1="16" y1="6.5" x2="11.3" y2="19.6" stroke="currentColor" stroke-width="1.4" opacity="0.5"/><line x1="16" y1="6.5" x2="20.7" y2="19.6" stroke="currentColor" stroke-width="1.4" opacity="0.5"/><line x1="11.3" y1="19.6" x2="20.7" y2="19.6" stroke="currentColor" stroke-width="1.4" opacity="0.5"/><circle cx="16" cy="6.5" r="2.6" fill="var(--accent)"/><circle cx="11.3" cy="19.6" r="2.4" fill="currentColor"/><circle cx="20.7" cy="19.6" r="2.4" fill="currentColor"/></svg><span>home<b>smartly</b></span></a><button class="icon-btn" data-menu-close aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></button></div>
  <nav>{navItems.map((item, i) => <a href={item.href}>{item.label}<span class="n">0{i + 1}</span></a>)}</nav>
</div>

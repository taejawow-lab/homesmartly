---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Compatibility Checker" description="Measured smart-home compatibility checker for homesmartly readers." active="tools">

  <section class="tool-hero wrap" data-screen-label="Checker / Hero">
    <span class="eyebrow">Interactive Tool · 01</span>
    <h1 class="serif">Will it work with your setup?</h1>
    <p class="lede">Pick your hub and the device you're eyeing. We'll tell you if it pairs natively, whether you need a Thread border router, and what to verify on the box before you buy.</p>
  </section>

  <section class="wrap" style="padding-bottom:80px" data-screen-label="Checker / Tool">
    <div class="tool-shell">
      <!-- inputs -->
      <div>
        <div class="panel">
          <span class="step">Step 01</span>
          <h2 class="serif">What's your hub?</h2>
          <div class="opt-grid" id="hubs">
            <button class="opt" data-hub="apple" aria-pressed="false"><span class="oic"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 13.2c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.8-3.5.8-.7 0-1.8-.8-3-.8-1.5 0-2.9.9-3.7 2.3-1.6 2.7-.4 6.8 1.1 9 .7 1.1 1.6 2.3 2.7 2.2 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7c1.2 0 1.9-1.1 2.6-2.2.5-.7.9-1.6 1.2-2.4-2.9-1.1-2.9-3.1-2.9-3.1zM13.7 6.6c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.6 1 .1 1.9-.5 2.5-1.2z"/></svg></span><span><span class="on">Apple Home</span><span class="os">HomePod / Apple TV</span></span></button>
            <button class="opt" data-hub="google" aria-pressed="false"><span class="oic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg></span><span><span class="on">Google Home</span><span class="os">Nest Hub / Mini</span></span></button>
            <button class="opt" data-hub="alexa" aria-pressed="false"><span class="oic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><span><span class="on">Amazon Alexa</span><span class="os">Echo 4 / Hub</span></span></button>
            <button class="opt" data-hub="smartthings" aria-pressed="false"><span class="oic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/></svg></span><span><span class="on">SmartThings</span><span class="os">Station / Hub</span></span></button>
            <button class="opt" data-hub="hass" aria-pressed="false"><span class="oic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3 4 10v10h16V10z"/><path d="M12 12v4M10 14h4"/></svg></span><span><span class="on">Home Assistant</span><span class="os">+ Thread radio</span></span></button>
            <button class="opt" data-hub="none" aria-pressed="false"><span class="oic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8 12h8"/></svg></span><span><span class="on">No hub yet</span><span class="os">Phone only</span></span></button>
          </div>

          <div class="divider-step"></div>

          <span class="step">Step 02</span>
          <h2 class="serif">What device?</h2>
          <div class="dev-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
            <input id="devq" type="text" placeholder="Search devices…" autocomplete="off">
          </div>
          <div class="dev-list" id="devlist"></div>
        </div>
      </div>

      <!-- result -->
      <div class="result">
        <div class="verdict empty" id="verdict">
          <div class="ve"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M9 11l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg></div>
          <p>Pick a hub and a device to see the verdict.</p>
        </div>
        <p class="fineprint" style="margin-top:18px">Compatibility reflects current Matter 1.5 support. Always verify the Matter logo on the retail box — a Thread logo alone does not guarantee Matter. <a href="/posts/smart-thermostat-vacation-mode-summer-travel-checklist-2026/" style="text-decoration:underline">Why this matters →</a></p>
      </div>
    </div>
  </section>

<script>
(function(){
  // device model
  function dic(p){return '<div class="dic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">'+p+'</svg></div>';}
  var IC={
    bulb:'<path d="M9 18h6M10 21h4M12 3a6 6 0 0 1 4 10.5c-.7.7-1 1.2-1 2.5H9c0-1.3-.3-1.8-1-2.5A6 6 0 0 1 12 3z"/>',
    lock:'<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
    plug:'<path d="M9 3v6M15 3v6M7 9h10v3a5 5 0 0 1-10 0z M12 17v4"/>',
    sensor:'<circle cx="12" cy="12" r="3"/><path d="M5 12a7 7 0 0 1 14 0M2.5 12a9.5 9.5 0 0 1 19 0"/>',
    therm:'<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.5"/>',
    alarm:'<circle cx="12" cy="12" r="8"/><path d="M12 9v3M12 15h.01"/>'
  };
  var DEVICES=[
    {id:'eve-door',name:'Eve Door & Window',type:'Contact sensor',ic:IC.sensor,conn:'thread'},
    {id:'nanoleaf',name:'Nanoleaf Essentials Bulb',type:'Light',ic:IC.bulb,conn:'thread'},
    {id:'yale-lock',name:'Yale Smart Lock with Matter',type:'Door lock',ic:IC.lock,conn:'thread'},
    {id:'eve-energy',name:'Eve Energy Smart Plug',type:'Plug / energy',ic:IC.plug,conn:'thread'},
    {id:'aqara-p2',name:'Aqara Door Sensor P2',type:'Contact sensor',ic:IC.sensor,conn:'thread'},
    {id:'tp-plug',name:'TP-Link Tapo Matter Plug',type:'Plug',ic:IC.plug,conn:'wifi'},
    {id:'ecobee',name:'Ecobee Smart Thermostat Premium',type:'Thermostat',ic:IC.therm,conn:'thread'},
    {id:'wiz',name:'WiZ Wi-Fi Bulb (Matter)',type:'Light',ic:IC.bulb,conn:'wifi'},
    {id:'smoke',name:'X-Sense Smart Smoke + CO Alarm',type:'Alarm',ic:IC.alarm,conn:'wifi'},
    {id:'leak',name:'Aqara Water Leak Sensor',type:'Leak sensor',ic:IC.sensor,conn:'zigbee'}
  ];

  // hub capabilities
  var HUBS={
    apple:{name:'Apple Home',tbr:true,matter:'full'},
    google:{name:'Google Home',tbr:true,matter:'partial'},
    alexa:{name:'Amazon Alexa',tbr:true,matter:'subset'},
    smartthings:{name:'SmartThings',tbr:true,matter:'full'},
    hass:{name:'Home Assistant',tbr:true,matter:'full'},
    none:{name:'no hub',tbr:false,matter:'none'}
  };

  var state={hub:null,dev:null,q:''};
  var devlist=document.getElementById('devlist'),verdict=document.getElementById('verdict');

  function renderDevs(){
    var list=DEVICES.filter(function(d){return !state.q || (d.name+' '+d.type).toLowerCase().indexOf(state.q.toLowerCase())>=0;});
    devlist.innerHTML=list.map(function(d){
      var conn=d.conn==='thread'?'Thread':d.conn==='wifi'?'Wi-Fi':'Zigbee';
      var pressed=state.dev===d.id?'true':'false';
      return '<button class="dev" data-dev="'+d.id+'" aria-pressed="'+pressed+'">'+dic(d.ic)
        +'<div><div class="dn">'+d.name+'</div><div class="dm"><span>'+d.type+'</span><span>·</span><span>'+conn+'</span></div></div></button>';
    }).join('');
    devlist.querySelectorAll('.dev').forEach(function(b){
      b.addEventListener('click',function(){ state.dev=b.getAttribute('data-dev'); renderDevs(); renderVerdict(); });
    });
  }

  function renderVerdict(){
    if(!state.hub||!state.dev){
      verdict.className='verdict empty';
      verdict.innerHTML='<div class="ve"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M9 11l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg></div><p>Pick a hub and a device to see the verdict.</p>';
      return;
    }
    var hub=HUBS[state.hub], dev=DEVICES.filter(function(d){return d.id===state.dev;})[0];
    var level='ok',head='',sub='',steps=[],cls;

    if(dev.conn==='zigbee'){
      level='no';
      head='Not directly compatible';
      sub='<b>'+dev.name+'</b> uses Zigbee, which Matter does not transport. You\u2019d need a Zigbee bridge that exposes it to '+hub.name+' as a Matter bridge.';
      steps=[['warn','Add a Zigbee hub (e.g. SmartThings or a HA Zigbee radio)'],['warn','Expose devices to '+hub.name+' via a Matter bridge'],['ok','Then control normally from your hub']];
    } else if(state.hub==='none'){
      level='warn';
      head='Works \u2014 but you\u2019ll want a hub';
      sub='<b>'+dev.name+'</b> can be set up from your phone, but '+(dev.conn==='thread'?'Thread devices need a border router to stay connected and to run automations.':'remote access and automations need a hub or controller.');
      steps=[['ok','Pair directly from the Matter setup flow on your phone'],['warn',(dev.conn==='thread'?'Add a Thread border router (Echo, HomePod, Nest Hub\u2026)':'Add any Matter controller for automations')],['warn','Without one, no remote control or routines']];
    } else if(dev.conn==='thread'){
      level= hub.tbr ? 'ok' : 'warn';
      head= hub.tbr ? 'Yes \u2014 native Matter over Thread' : 'Needs a Thread border router';
      sub='<b>'+dev.name+'</b> is a Matter-over-Thread device. '+(hub.tbr? hub.name+' includes a Thread border router, so it pairs and routes natively.' : hub.name+' can control it, but you must add a border router first.');
      steps=[
        ['ok','Confirm the Matter logo on the box'],
        [hub.tbr?'ok':'warn', hub.tbr? hub.name+' already has a Thread border router':'Add a Thread border router to your network'],
        ['ok','Scan the Matter QR code to commission it']
      ];
      if(hub.matter==='partial'||hub.matter==='subset'){ steps.push(['warn','Note: '+hub.name+' implements a subset of the Matter spec \u2014 some device types may not surface yet']); }
    } else { // wifi matter
      level='ok';
      head='Yes \u2014 Matter over Wi-Fi';
      sub='<b>'+dev.name+'</b> is a Matter-over-Wi-Fi device. No border router needed \u2014 it joins your existing Wi-Fi and '+hub.name+' controls it directly.';
      steps=[['ok','Confirm the Matter logo on the box'],['ok','Join your 2.4GHz Wi-Fi during setup'],['ok','Scan the Matter QR code in the '+hub.name+' app']];
      if(hub.matter==='subset'){ steps.push(['warn','Alexa implements a Matter subset \u2014 verify your device type is supported']); }
    }

    var icons={ok:'<path d="M5 12l5 5L20 6"/>',warn:'<path d="M12 8v5M12 17h.01"/>',no:'<path d="M7 7l10 10M17 7L7 17"/>'};
    var matrix=[
      ['Connection', dev.conn==='thread'?'Thread':dev.conn==='wifi'?'Wi-Fi':'Zigbee', dev.conn==='zigbee'?'no':'ok'],
      ['Border router', dev.conn==='thread'?(hub.tbr?'Included':'Required'):'Not needed', dev.conn==='thread'?(hub.tbr?'ok':'warn'):'ok'],
      ['Hub Matter support', hub.matter==='full'?'Full':hub.matter==='partial'?'Partial':hub.matter==='subset'?'Subset':'\u2014', hub.matter==='full'?'ok':hub.matter==='none'?'no':'warn']
    ];

    verdict.className='verdict '+level;
    verdict.innerHTML=
      '<div class="v-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">'+icons[level]+'</svg></div>'
      +'<div class="v-head serif">'+head+'</div>'
      +'<p class="v-sub">'+sub+'</p>'
      +'<ul class="v-steps">'+steps.map(function(s){return '<li><span class="si '+s[0]+'">'+(s[0]==='ok'?'\u2713':'!')+'</span><span>'+s[1]+'</span></li>';}).join('')+'</ul>'
      +'<div class="v-matrix">'+matrix.map(function(m){return '<span class="badge '+m[2]+'">'+m[0]+': '+m[1]+'</span>';}).join('')+'</div>'
      +'<div class="v-cta"><a class="btn btn-accent" href="/guide/">See recommended '+dev.type.toLowerCase()+'s \u2192</a><a class="btn btn-ghost" href="/starter-kit-builder/">Build a full kit</a></div>';
  }

  document.querySelectorAll('#hubs .opt').forEach(function(b){
    b.addEventListener('click',function(){
      document.querySelectorAll('#hubs .opt').forEach(function(x){x.setAttribute('aria-pressed','false');});
      b.setAttribute('aria-pressed','true');
      state.hub=b.getAttribute('data-hub');
      renderVerdict();
    });
  });
  var devq=document.getElementById('devq');
  devq.addEventListener('input',function(){state.q=devq.value.trim();renderDevs();});

  renderDevs();
})();
</script>
</BaseLayout>
